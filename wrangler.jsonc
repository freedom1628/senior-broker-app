{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senior-broker-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "production",
    "NEXTAUTH_URL": "https://senior-broker-app.workers.dev"
  }
}
